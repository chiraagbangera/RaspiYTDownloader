[Unit]
Description=Raspberry Pi YouTube Downloader
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/Videos

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/pi-ytdlp-web

Environment=DOWNLOAD_DIR=/mnt/Videos
Environment=TEMP_DOWNLOAD_DIR=/var/tmp/ytdlp-web
Environment=YTDLP_BIN=/usr/local/bin/yt-dlp
Environment=MAX_CONCURRENT_DOWNLOADS=2
Environment=MAX_LOG_LINES=500

ExecStart=/opt/pi-ytdlp-web/.venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:100 --access-logfile - --error-logfile - app:app

Restart=on-failure
RestartSec=3

# Allow binding to privileged port 100 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/Videos /var/tmp/ytdlp-web

[Install]
WantedBy=multi-user.target
